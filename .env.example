# Copiar como .dev.vars para el desarrollo local.
# Nunca reemplazar estos placeholders dentro del archivo versionado.

VISITOR_ALERT_TOKEN=replace-with-a-long-random-secret
RESEND_API_KEY=replace-with-your-resend-api-key
NOTIFICATION_TO_EMAIL=contacto@modomza.com
NOTIFICATION_FROM_EMAIL=Modo MZA <notificaciones@modomza.com.ar>

# Login con Google (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# Secreto propio para firmar la sesión y el estado de OAuth (cualquier string largo al azar)
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Búsqueda inteligente (platform.openai.com/api-keys)
OPENAI_API_KEY=replace-with-your-openai-api-key
